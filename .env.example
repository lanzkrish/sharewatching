# MongoDB Connection
# Set your MongoDB connection URI (e.g. mongodb://localhost:27017/sharewatching or MongoDB Atlas URI)
# If not set, ShareWatching will automatically run in local persistent memory mode!
MONGODB_URI=mongodb://localhost:27017/sharewatching

# JWT Secret for Authentication
JWT_SECRET=super_secret_jwt_key_sharewatching_2026_change_this_in_production

# Amazon S3 Configuration
# If configured, videos will upload to user-specific folders: users/{userId}/videos/...
# If not configured, ShareWatching falls back automatically to local storage (/public/uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=sharewatching-videos

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Real-Time WebSocket Signaling Server (DigitalOcean Droplet URL or localhost:5001)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5001
