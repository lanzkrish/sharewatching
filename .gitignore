# Dependencies (Root and Subdirectories like server/node_modules)
node_modules/
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Local Video Uploads (Prevent multi-gigabyte video commits)
public/uploads/
/public/uploads/
!public/uploads/.gitkeep

# Next.js & Build Outputs
.next/
/.next/
/out/
dist/
/build

# Hosting platforms
.netlify/
.vercel/

# Testing & Coverage
/coverage

# Environment & Secret files
.env
.env*.local
.env.production
.env.development
.env.test
server/.env
# Keep example env files tracked in git
!.env.example
!server/.env.example

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor & IDE configs
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript & Security Keys
*.tsbuildinfo
next-env.d.ts
*.pem
